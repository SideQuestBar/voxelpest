# The web viewer's deployment to Cloudflare Pages (scripts/publish_web.sh, ./bv publish-web). Copy to
# ~/.config/voxelpest/web.env (or web/deploy/web.env, which git ignores) and fill in. It is independent of the
# Minecraft server's (minecraft/minecraft.env.example).

# the Pages project (created on the first publish) and its production branch: deploys to it go live
CF_PROJECT=voxelpest
CF_BRANCH=master

# The first publish logs in through the browser (wrangler login). To publish without a browser, give wrangler an API
# token with the "Cloudflare Pages: Edit" permission instead. The account id is needed when the login sees several.
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=
#WRANGLER_VERSION=4

# The site is at https://$CF_PROJECT.pages.dev. A domain of your own is added once in the dashboard (Workers & Pages,
# the project, Custom domains); set it here too so the publish prints it.
#WEB_DOMAIN=map.side-quest.bar

# links in the viewer
BAR_URL=https://side-quest.bar

# Feature flag: the "Play in Minecraft" card (off unless true). Its address, and optionally a status URL answering
# {"online":3,"max":50,...} (the plugin's GET /status, if you publish it; https, since Pages serves the site over
# https); without one, api.mcstatus.io is asked.
MINECRAFT=false
MC_ADDRESS=mc.side-quest.bar
#MC_STATUS_URL=https://mc.side-quest.bar/status

# Umami analytics (off unless both are set): your Umami server and the website's id from its settings. Visits and
# events (mode, vehicle, place, time, weather, the bar's card...) are recorded; never a position, and not the page's
# query string. Browsers asking not to be tracked aren't. The dev server (./bv web) only reports with UMAMI_DEV=1.
#UMAMI_URL=https://umami.example.com
#UMAMI_ID=00000000-0000-0000-0000-000000000000
