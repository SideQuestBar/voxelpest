# The Minecraft server's deployment (scripts/publish_minecraft.sh, ./bv publish-minecraft). Copy to
# ~/.config/voxelpest/minecraft.env (or minecraft/minecraft.env, which git ignores) and fill in. It is
# independent of the web viewer's (web/deploy/web.env.example).

# where it runs: an ssh target (a Tailscale name works) and a directory there
MC_HOST=user@server
MC_DIR=/srv/voxelpest-minecraft

# You agree to the Minecraft EULA (https://aka.ms/MinecraftEULA) by setting this to true.
EULA=false

# the server's address, and the links its /map and /bar commands give
MC_ADDRESS=mc.side-quest.bar
MAP_URL=https://map.side-quest.bar
BAR_URL=https://side-quest.bar

MC_VERSION=26.3
MEMORY=4G
MAX_PLAYERS=50
VIEW_DISTANCE=10
BEDROCK=true          # Geyser + Floodgate: Bedrock players (phones, tablets, Windows) join on port 19132
VIA=true              # ViaVersion + ViaBackwards: Java players on other versions can join too
#MOTD='§6Budapest§r in blocks\n§7by SideQuest Bar'   # the server list's two lines, in quotes (§ colours)

# The player count (GET /status) for the viewer's "Play in Minecraft" card: by default only on the machine itself
# (127.0.0.1:8765). STATUS_BIND=0.0.0.0 publishes it, behind your own HTTPS proxy ideally.
#STATUS_PORT=8765
#STATUS_BIND=127.0.0.1

# set to false when something else (by hand, another tool) runs `docker compose up` there
RUN_COMPOSE=true
